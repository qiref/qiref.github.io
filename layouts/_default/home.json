{{/* home.json */ -}}
{
  "version": "hugo-{{ hugo.Version }}",
  "timestamp": "{{ now.Format "2006-01-02T15:04:05Z07:00" }}",
  "pages": [
    {{- $pages := where .Site.RegularPages.ByDate.Reverse "Type" "not in" (slice "search") -}}
    {{- range $index, $page := $pages -}}
    {
      "title": {{ $page.Title | jsonify }},
      "url": {{ $page.RelPermalink | jsonify }},
      "date": {{ if gt $page.Date.Year 1 }}{{ $page.Date.Format "2006/01/02" | jsonify }}{{ else }}""{{ end }},
      "section": {{ $page.Section | jsonify }},
      "content": {{ $page.Plain | jsonify }}
    }{{ if ne (add $index 1) (len $pages) }},{{ end }}
    {{- end -}}
  ]
}
